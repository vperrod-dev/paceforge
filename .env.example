# PaceForge — one athlete per copy, file-based. No database, no LLM API key.
#
# These are the CLI's variables. On the VM, the job runner reads its own set from
# ~/.config/paceforge/env (or ~/.config/paceforge/<name>.env for another athlete's
# instance, written by scripts/users.py) — see CLAUDE.md §"Auth & secrets".

# Garmin (required for the CLI; the portal's Connect Garmin needs none of them)
PACEFORGE_GARMIN_EMAIL=you@example.com
PACEFORGE_GARMIN_PASSWORD=         # only needed for the one-time `paceforge login`
PACEFORGE_GARMIN_TOKEN_DIR=        # cached session dir (default ~/.garminconnect)
GARMIN_TOKEN=                      # portable token blob from `paceforge export-token`,
                                   # for restoring a session on another machine

# Strava (optional — activity description push)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Data location (default ./data)
PACEFORGE_DATA_DIR=
