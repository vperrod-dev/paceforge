<workout_file>
    <author>PaceForge</author>
    <name>6x1 Anaerobic</name>
    <description>Six 1-minute efforts well above threshold with long recoveries. Trains the capacity to attack, close gaps and survive surges — quality over quantity, every rep full gas.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="anaerobic"/>
        <tag name="z6"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.40" PowerHigh="0.80" Cadence="90">
            <textevent timeoffset="30" message="Thorough warmup — these efforts punish cold legs."/>
            <textevent timeoffset="600" message="First 1-minute effort in 2 minutes. Big gear ready."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="240" OnPower="1.30" OffPower="0.45" Cadence="100" CadenceResting="85">
            <textevent timeoffset="5" message="Full commitment — 60 seconds, nothing held back."/>
            <textevent timeoffset="45" message="15 seconds. Hold it."/>
            <textevent timeoffset="60" message="Recover completely — the next one deserves fresh legs."/>
        </IntervalsT>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="30" message="Done. Spin very easy, heart rate right down."/>
        </Cooldown>
    </workout>
</workout_file>
