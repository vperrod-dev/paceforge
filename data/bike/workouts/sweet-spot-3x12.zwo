<workout_file>
    <author>PaceForge</author>
    <name>3x12 Sweet Spot</name>
    <description>Three 12-minute sweet-spot blocks — the stepping stone toward 2x20. Same pressure, shorter bites, generous recovery.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="sweetspot"/>
        <tag name="threshold"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.75" Cadence="90">
            <textevent timeoffset="30" message="Build gradually — first block in 10 minutes."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="240" OnPower="0.90" OffPower="0.50" Cadence="90" CadenceResting="85">
            <textevent timeoffset="60" message="Strong but sustainable — you should finish each block wanting one more minute."/>
            <textevent timeoffset="600" message="2 min left in the block. Hold form."/>
            <textevent timeoffset="720" message="Recovery. Spin light, drink."/>
        </IntervalsT>
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40">
            <textevent timeoffset="30" message="Done. Flush the legs."/>
        </Cooldown>
    </workout>
</workout_file>
