<workout_file>
    <author>PaceForge</author>
    <name>5x5 VO2</name>
    <description>The classic five-by-five: 5 minutes hard, 5 minutes easy, five times. Simple to remember, brutally effective at raising your aerobic ceiling.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="vo2max"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.75" Cadence="90">
            <textevent timeoffset="30" message="Warm up properly — the first rep starts fast."/>
            <textevent timeoffset="540" message="First 5-minute effort in 1 minute. High cadence, big breaths."/>
        </Warmup>
        <IntervalsT Repeat="5" OnDuration="300" OffDuration="300" OnPower="1.15" OffPower="0.50" Cadence="100" CadenceResting="85">
            <textevent timeoffset="15" message="Get on top of the gear early."/>
            <textevent timeoffset="240" message="1 min left — everything you have to the line."/>
            <textevent timeoffset="300" message="Recover. Full 5 minutes, use all of it."/>
        </IntervalsT>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40">
            <textevent timeoffset="30" message="That was the hard part of your week. Spin easy."/>
        </Cooldown>
    </workout>
</workout_file>
